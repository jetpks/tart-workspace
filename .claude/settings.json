{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [{"type": "command", "command": "architect", "args": ["ground"]}]
      },
      {
        "matcher": "clear",
        "hooks": [{"type": "command", "command": "architect", "args": ["ground"]}]
      },
      {
        "matcher": "resume",
        "hooks": [{"type": "command", "command": "architect", "args": ["ground"]}]
      }
    ]
  }
}
