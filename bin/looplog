#!/usr/bin/env ruby
# frozen_string_literal: true

# looplog — follow every active pi-subagents run in this space, live.
#
#   bin/looplog              # follow active runs as they stream
#   bin/looplog --list       # inventory only (active/age/size/agent per run)
#   bin/looplog --replay     # print existing history on adoption, then follow
#   bin/looplog --all        # adopt every transcript, however stale
#   bin/looplog --space PATH # default: nearest ancestor with space.yaml
#
# Forked from ~/bin/runlog (2026-10-12) for the subagents fan-out. The source
# is pi-subagents' artifact transcripts — ~/.pi/agent/sessions/--<space>--/**/
# subagent-artifacts/<runid>_<agent>_transcript.jsonl, nested session dirs
# included, so the coordinator, its spec/builder/judge children, and deeper
# descendants all appear. Records are message-granularity (no stream deltas):
# assistant rounds arrive whole with thinking/text blocks, usage, and a stop
# reason; tool args ride tool_start records; results arrive as toolResult
# messages. runlog's display discipline carries over: thinking dim, assistant
# text plain, tool calls one-lined with their args, results one-lined with a
# line count, ✓ done / ✗ failed with usage summed across the exchange, and
# truncation at RUNLOG_LIMIT (default 2000) characters. Thinking text is NOT
# truncated — set RUNLOG_THINK to clamp it if a run goes feral.

require "json"
require "find"

LIMIT = (ENV["RUNLOG_LIMIT"] || 2000).to_i
THINK_LIMIT = ENV["RUNLOG_THINK"]&.to_i
WINDOW = (ENV["LOOPLOG_WINDOW"] || 900).to_i # seconds: staleness threshold

COLOR = $stdout.tty? && ENV["NO_COLOR"].nil?

def paint(text, code)
  COLOR ? "\e[#{code}m#{text}\e[0m" : text
end

def dim(s)    = paint(s, "2")
def bold(s)   = paint(s, "1")
def cyan(s)   = paint(s, "36")
def green(s)  = paint(s, "32")
def red(s)    = paint(s, "31")

# Collapses whitespace and clips, so a tool argument stays on one line.
def oneline(value, limit = LIMIT)
  s = value.to_s.gsub(/\s+/, " ").strip
  s.length > limit ? "#{s[0, limit]}…" : s
end

def clip(text, limit = nil)
  return text if limit.nil? || text.length <= limit

  "#{text[0, limit]}…"
end

# --- space + transcript discovery -------------------------------------------

def space_root(start)
  dir = File.expand_path(start)
  loop do
    return dir if File.exist?(File.join(dir, "space.yaml"))
    parent = File.dirname(dir)
    return nil if parent == dir
    dir = parent
  end
end

def sessions_root
  ENV["PI_SESSIONS_DIR"] || File.join(Dir.home, ".pi", "agent", "sessions")
end

# pi names a session dir after the project root, dash-cased: the absolute
# path's leading slash contributes one leading dash, pi adds one more, and a
# trailing pair closes it (verified: …/20261009-pi-port → --Users-eric-
# architect-spaces-20261009-pi-port--; /private/tmp/tart-bang-smoke →
# --private-tmp-tart-bang-smoke--).
def session_slug(path)
  "-#{path.tr('/', '-')}--"
end

Transcript = Struct.new(:path, :run_id, :agent, :mtime, :size, :cwd, :task)

def discover(space)
  root = File.join(sessions_root, session_slug(space))
  return [] unless File.directory?(root)

  Find.find(root).filter_map do |p|
    next unless p.end_with?("_transcript.jsonl") && File.file?(p)

    base = File.basename(p, ".jsonl").delete_suffix("_transcript")
    run_id, agent = base.split("_", 2)
    next unless run_id && agent

    st = File.stat(p)
    Transcript.new(p, run_id, agent, st.mtime.to_f, st.size, nil, nil)
  end
end

# Bounded backscan for the newest "Task:" user record and the live cwd —
# every record carries cwd, so the file's tail suffices; the Task: record
# lives at the head, so a tail miss falls back to the first 64 KB.
def backscan(path)
  tail = []
  File.open(path, "rb") do |f|
    f.seek(0, IO::SEEK_END)
    window = [f.tell, 64 * 1024].min
    f.seek(-window, IO::SEEK_END)
    f.each_line { |l| tail << l }
  end
  head = []
  File.open(path, "rb") do |f|
    f.each_line { |l| head << l; break if head.sum(&:bytesize) > 64 * 1024 }
  end
  task = nil
  cwd = nil
  tail.reverse_each { |l| cwd, task = note_record(l, cwd, task) }
  head.reverse_each { |l| cwd, task = note_record(l, cwd, task) }
  [cwd, task]
end

def note_record(line, cwd, task)
  return [cwd, task] unless line.start_with?("{") && (cwd.nil? || task.nil?)

  rec = begin
    JSON.parse(line)
  rescue JSON::ParserError
    nil
  end
  return [cwd, task] unless rec

  cwd ||= rec["cwd"]
  if task.nil? && rec["recordType"] == "message" && rec["role"] == "user" &&
     rec["text"].to_s.start_with?("Task:")
    task = rec["text"].lines.first.chomp[0, 110]
  end
  [cwd, task]
end

ROLE_ABBREV = {
  "architect-coordinator" => "coord",
  "architect-spec" => "spec",
  "architect-judge" => "judge",
  "architect-builder" => "bld"
}.freeze

# [bld:I35-editor-multiline-core] when cwd is a lane worktree, else the role.
def tag_label(agent, cwd)
  role = ROLE_ABBREV.fetch(agent, agent[0, 10])
  return role unless cwd && File.basename(cwd) == "wt"

  lane = File.basename(File.dirname(cwd)).sub(/\A[Ii]\d+-/, "")
  "#{role}:#{lane[0, 26]}"
end

TAG_COLORS = %w[36 35 33 32 34 95 96 91].freeze

def paint_tag(label, run_id)
  code = TAG_COLORS[run_id.sum % TAG_COLORS.size]
  paint("[#{label}]", code)
end

# --- per-run rendering ---------------------------------------------------------

# Adapts runlog's Printer to whole-message transcript records; emits fully
# painted lines (the follower prefixes the per-run tag).
class Renderer
  def initialize
    @exchange = nil # usage accumulated across the rounds of an exchange
  end

  def render(rec)
    case rec["recordType"]
    when "tool_start" then [tool_call(rec)]
    when "tool_end"   then [] # the result rides the toolResult message
    when "message"    then message(rec)
    else []
    end
  end

  private

  def message(rec)
    case rec["role"]
    when "assistant" then assistant(rec)
    when "toolResult" then [tool_result(rec)]
    when "user"
      # A user message opens an exchange; every assistant round that follows
      # belongs to it, up through the final (non-toolUse) stop.
      @exchange = { started_at: rec["ts"], output: 0, cache_read: 0, cost: 0.0 }
      []
    else # system/custom echoes: everything of interest shows elsewhere
      []
    end
  end

  def assistant(rec)
    lines = []
    (rec.dig("message", "content") || []).each do |block|
      case block["type"]
      when "thinking"
        text = clip(block["thinking"].to_s, THINK_LIMIT)
        next if text.empty?

        lines << dim("· thinking")
        text.lines.each { |l| lines << dim(l.chomp) }
      when "text"
        text = block["text"].to_s
        next if text.empty?

        lines << bold("● assistant")
        text.lines.each { |l| lines << l.chomp }
      end
      # toolCall blocks: the harness re-emits canonical args on tool_start,
      # which is what we display — one source, reflecting what actually ran.
    end
    lines << usage_line(rec) if final_stop?(rec)
    lines
  end

  def final_stop?(rec)
    reason = rec["stopReason"]
    reason && reason != "toolUse"
  end

  def usage_line(rec)
    u = rec["usage"] || {}
    ex = @exchange
    output = (ex ? ex[:output] : 0) + u["output"].to_i
    cache = (ex ? ex[:cache_read] : 0) + u["cacheRead"].to_i
    cost = (ex ? ex[:cost] : 0.0) + u.dig("cost", "total").to_f
    started = ex ? ex[:started_at] : nil
    @exchange = nil
    elapsed = started && rec["ts"] ? (rec["ts"] - started) / 1000 : nil
    stats = [
      "#{output} out",
      "#{cache} cache read",
      ("$#{format('%.2f', cost)}" if cost.positive?),
      ("#{format('%.0f', elapsed)}s" if elapsed)
    ].compact.join("  ")
    failed = rec["stopReason"].to_s.casecmp("error").zero?
    (failed ? red("✗ failed") : green("✓ done")) + dim("  #{stats}")
  end

  def tool_call(rec)
    args = begin
      JSON.parse(rec["argsPayload"] || "")
    rescue JSON::ParserError, TypeError
      nil
    end
    summary = if args.is_a?(Hash)
                args.map { |k, v| "#{k}: #{oneline(v)}" }.join("  ")
              else
                oneline(rec["argsPreview"])
              end
    "#{cyan("⚒ #{rec['toolName']}")} #{dim(summary)}"
  end

  def tool_result(rec)
    body = rec["text"].to_s
    note = body.lines.size > 1 ? dim(" (#{body.lines.size} lines)") : ""
    marker = rec["isError"] ? red("✗") : green("←")
    "#{marker} #{oneline(body)}#{note}"
  end
end

# --- follower ------------------------------------------------------------------

class Follower
  POLL = 0.5
  RESCAN = 2.0

  Run = Struct.new(:path, :run_id, :agent, :tag, :renderer, :offset, :partial)

  def initialize(space:, replay:, all:, list_only:)
    @space = space
    @replay = replay
    @all = all
    @list_only = list_only
    @runs = {}
  end

  def run
    scan
    return if @list_only

    last_scan = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    loop do
      sleep POLL
      @runs.each_value { |r| drain(r) }
      now = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      if now - last_scan >= RESCAN
        scan
        last_scan = now
      end
    end
  rescue Interrupt
    # ctrl+c while following: exit quietly with the output already on screen.
  end

  private

  def scan
    now = Time.now.to_f
    if @list_only
      discover(@space).sort_by { |t| -t.mtime }.each do |t|
        age_min = (now - t.mtime) / 60
        active = (now - t.mtime) < WINDOW
        cwd, task = backscan(t.path)
        puts format("%s %-9s %5.0fm %7sK  %s  %s",
                    active ? green("●") : dim("·"),
                    tag_label(t.agent, cwd),
                    age_min, t.size / 1024,
                    dim(t.run_id[0, 8]),
                    dim(task.to_s[0, 70]))
      end
      return
    end
    discover(@space).each do |t|
      next if @runs.key?(t.path)
      next unless @all || (now - t.mtime) < WINDOW

      adopt(t)
    end
  end

  def adopt(t)
    cwd, task = backscan(t.path)
    tag = paint_tag(tag_label(t.agent, cwd), t.run_id)
    run = Run.new(t.path, t.run_id, t.agent, tag, Renderer.new,
                  @replay ? 0 : t.size, +"")
    @runs[t.path] = run
    emit(run, [bold("▶ #{t.agent} #{t.run_id[0, 8]}") +
               (cwd ? dim("  @ #{cwd.sub(Dir.home, '~')}") : "") +
               (task ? dim(" — #{task}") : "")])
  end

  def drain(run)
    return unless File.exist?(run.path) && File.size(run.path) > run.offset

    File.open(run.path, "rb") do |f|
      f.seek(run.offset)
      run.partial << f.read
      run.offset = f.tell
    end
    while (idx = run.partial.index("\n"))
      line = run.partial.slice!(0..idx)
      next unless line.start_with?("{")

      rec = begin
        JSON.parse(line)
      rescue JSON::ParserError
        next
      end
      emit(run, run.renderer.render(rec))
    end
  end

  def emit(run, lines)
    lines.each { |l| puts "#{run.tag} #{l}" unless l.nil? || l.empty? }
    $stdout.flush
  end
end

# --- entry -----------------------------------------------------------------------

space = nil
replay = false
all = false
list = false
args = ARGV.dup
until args.empty?
  case (arg = args.shift)
  when "--list"   then list = true
  when "--replay" then replay = true
  when "--all"    then all = true
  when "--space"  then space = args.shift
  else abort "usage: looplog [--list] [--replay] [--all] [--space PATH]  (unknown: #{arg})"
  end
end

space ||= space_root(Dir.pwd)
abort "looplog: no space root upward from #{Dir.pwd} (or pass --space PATH)" unless space

Follower.new(space: space, replay: replay, all: all, list_only: list).run
